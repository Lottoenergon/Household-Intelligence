{
  "version": 2,
  "functions": {
    "app.py": {
      "includeFiles": "{backend,data/processed,models,frontend}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/app.py"
    },
    {
      "source": "/llms.txt",
      "destination": "/app.py"
    },
    {
      "source": "/robots.txt",
      "destination": "/app.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
